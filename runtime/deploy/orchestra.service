[Unit]
Description=Agent Orchestra runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/agent-orchestra/runtime
ExecStart=/usr/bin/python3 /opt/agent-orchestra/runtime/orchestra.py --daemon --interval 300
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target

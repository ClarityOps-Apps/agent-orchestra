# Agent Orchestra runtime environment template.
# Copy to .env on the target machine. Never commit real secrets.

# Model providers
OPENAI_API_KEY=
ATLAS_MODEL=
ANTHROPIC_API_KEY=
CODY_MODEL=
SCRIBE_MODEL=
SCOUT_MODEL=

# MCP integrations
ASANA_ACCESS_TOKEN=
ASANA_WORKSPACE_GID=
GITHUB_TOKEN=
GITHUB_ORG=Clarity-Apps
GITHUB_REPO=agent-orchestra
SUPABASE_ACCESS_TOKEN=

# Runtime
ORCHESTRA_ROOT=/opt/agent-orchestra/runtime
ORCHESTRA_LOG_PATH=memory/activity.log
ORCHESTRA_DECISIONS_DIR=memory/decisions
ORCHESTRA_ACTION_SURFACE=safe
